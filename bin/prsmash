#!/usr/bin/env bash
#
# prsmash — Review PRs in your queue in parallel, with optional selection.
#
# Usage:
#   prsmash              # pick PRs via fzf, then review selected in parallel
#   prsmash --all        # review every PR in the queue, no prompt
#   prsmash --dry-run    # show what would be reviewed
#   prsmash --include-implicit  # include implicit re-review candidates in manual mode
#   prsmash --model openai-codex/gpt-5.6-sol --thinking high
#   prsmash --trusted-authors alice,bob   # configure authors trusted for large PRs
#
# Large PRs by authors outside the trusted list get their review posted as a
# comment plus a Slack DM. Reacting to that DM approves (or drops) the PR on the
# next run — see "Approving from Slack" in the README.
#
set -eo pipefail

QUEUE_SCRIPT="${PRSMASH_QUEUE_SCRIPT:-$HOME/.claude/skills/review-queue/scripts/review-queue.sh}"
PR_REVIEW_SKILL_DIR="${PR_REVIEW_SKILL_DIR:-$HOME/agent-skills/skills/pr-review}"
PRSMASH_SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
PRSMASH_LIB_DIR="${PRSMASH_LIB_DIR:-$(dirname "$PRSMASH_SCRIPT_PATH")/../lib}"
# shellcheck source=../lib/review-disposition-state.sh
source "$PRSMASH_LIB_DIR/review-disposition-state.sh"
PRSMASH_SOURCE_REPO="${PRSMASH_SOURCE_REPO:-$HOME/dev/lleverage-ai/lleverage}"
SLACK_SCRIPT="${PRSMASH_SLACK_SCRIPT:-$HOME/.claude/skills/slack/scripts/slack.sh}"
SLACK_APPROVAL_NOTIFY="${PRSMASH_SLACK_APPROVAL_NOTIFY:-true}"
SLACK_APPROVAL_TARGET="${PRSMASH_SLACK_APPROVAL_TARGET:-@tom}"
# Authors whose large PRs we are happy to have approved without a human looking.
# Untrusted authors only need human sign-off when the changed-line limit is met.
TRUSTED_AUTHORS="${PRSMASH_TRUSTED_AUTHORS-jaythegeek,corixdean,gsasu,beddial}"
APPROVAL_LINE_LIMIT="${PRSMASH_APPROVAL_LINE_LIMIT:-${PRSMASH_APPROVAL_MAX_LINES:-1001}}"
AUTO_APPROVE_ALL="${PRSMASH_AUTO_APPROVE_ALL:-false}"
# Reaction-driven approval. A PR held back for a human gets a DM; reacting to
# that DM approves or drops it, and the next run picks the reaction up. The
# first emoji in each list is the one the DM tells you to use.
APPROVE_REACTIONS="${PRSMASH_APPROVE_REACTIONS:-+1,thumbsup,white_check_mark,heavy_check_mark}"
REJECT_REACTIONS="${PRSMASH_REJECT_REACTIONS:--1,thumbsdown,x,no_entry_sign}"
# Pending approvals this old are dropped rather than left waiting forever.
APPROVAL_PENDING_TTL_DAYS="${PRSMASH_APPROVAL_PENDING_TTL_DAYS:-14}"
# Whose reaction counts. Defaults to the Slack user the tokens belong to.
APPROVAL_ACTOR="${PRSMASH_SLACK_APPROVAL_USER:-}"
# Hard cap on a single review. A review agent can spawn a child that never exits
# (e.g. importing react-dom/server.browser.js under node keeps the event loop
# alive forever), which otherwise wedges the run, the systemd unit, and every
# subsequent timer firing. p99 review duration is ~32m, so 45m only cuts runs
# that are already pathological.
REVIEW_TIMEOUT="${PRSMASH_REVIEW_TIMEOUT:-2700}"

# --- Colours ---
BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[32m'
RED='\033[31m'
YELLOW='\033[33m'
BLUE='\033[34m'
RESET='\033[0m'

# --- Args ---
DRY_RUN=false
SKIP_SELECT=false
INCLUDE_IMPLICIT=false
# Default model resolution: --model flag > PI_PRSMASH_MODEL env > the model
# file written by prsmash-model > built-in default. The file lets the default
# be switched without editing this script or the systemd units.
MODEL_FILE="${PRSMASH_MODEL_FILE:-${PRSMASH_LOG_DIR:-$HOME/.prsmash}/model}"
DEFAULT_MODEL="anthropic-claude-code/claude-opus-4-8"
if [[ -f "$MODEL_FILE" ]]; then
  saved_model=$(head -n1 "$MODEL_FILE" 2>/dev/null | tr -d '[:space:]')
  [[ -n "$saved_model" ]] && DEFAULT_MODEL="$saved_model"
fi
MODEL="${PI_PRSMASH_MODEL:-$DEFAULT_MODEL}"
THINKING_LEVEL="${PI_PRSMASH_THINKING:-high}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --all|--no-select) SKIP_SELECT=true; shift ;;
    --include-implicit) INCLUDE_IMPLICIT=true; shift ;;
    --approval-line-limit) APPROVAL_LINE_LIMIT="${2:-}"; [[ -n "$APPROVAL_LINE_LIMIT" ]] || { echo "--approval-line-limit requires a value" >&2; exit 1; }; shift 2 ;;
    --trusted-authors) TRUSTED_AUTHORS="${2-}"; [[ $# -ge 2 ]] || { echo "--trusted-authors requires a value" >&2; exit 1; }; shift 2 ;;
    --model) MODEL="${2:-}"; [[ -n "$MODEL" ]] || { echo "--model requires a value" >&2; exit 1; }; shift 2 ;;
    --thinking) THINKING_LEVEL="${2:-}"; [[ -n "$THINKING_LEVEL" ]] || { echo "--thinking requires a value" >&2; exit 1; }; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

AUTO_APPROVE_ALL=$(printf '%s' "$AUTO_APPROVE_ALL" | tr '[:upper:]' '[:lower:]')
case "$AUTO_APPROVE_ALL" in
  true|false) ;;
  *) echo "PRSMASH_AUTO_APPROVE_ALL must be true or false." >&2; exit 1 ;;
esac

if [[ "$AUTO_APPROVE_ALL" != true ]]; then
  if ! [[ "$APPROVAL_LINE_LIMIT" =~ ^[0-9]+$ ]] || [[ "$APPROVAL_LINE_LIMIT" -le 0 ]]; then
    echo "PRSMASH_APPROVAL_LINE_LIMIT must be a positive integer." >&2
    exit 1
  fi
fi

# --- Locks and logs ---
LOG_ROOT="${PRSMASH_LOG_DIR:-$HOME/.prsmash}"
mkdir -p "$LOG_ROOT/locks"
PENDING_DIR="$LOG_ROOT/pending-approvals"
PROCESSED_DIR="$LOG_ROOT/processed-approvals"
review_disposition_state_init "$LOG_ROOT"
if [[ "$DRY_RUN" != true ]]; then
  backfill_approval_review_dispositions "$PENDING_DIR" "$PROCESSED_DIR"
  disposition_backfill_marker="$LOG_ROOT/.review-disposition-log-backfill-v1"
  if [[ ! -f "$disposition_backfill_marker" ]]; then
    backfill_logged_issue_comment_dispositions "$LOG_ROOT/runs"
    disposition_backfill_tmp=$(mktemp "${disposition_backfill_marker}.tmp.XXXXXX")
    date -Is > "$disposition_backfill_tmp"
    mv "$disposition_backfill_tmp" "$disposition_backfill_marker"
  fi
fi

# The whole-process lock keeps two interactive runs from fighting over the same
# queue. Scheduled runs opt out: per-PR flocks (see review_pr) already make
# concurrent runs safe, and holding this lock means one slow review suppresses
# every subsequent tick rather than just the PRs it is working on.
if [[ "${PRSMASH_ALLOW_CONCURRENT:-0}" != "1" ]]; then
  exec 9>"$LOG_ROOT/locks/prsmash.lock"
  if ! flock -n 9; then
    echo "Another prsmash instance is already running. Exiting." >&2
    exit 1
  fi
fi

RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
RUN_DIR="$LOG_ROOT/runs/$RUN_ID"
mkdir -p "$RUN_DIR"
ln -sfn "$RUN_DIR" "$LOG_ROOT/latest"

exec > >(tee -a "$RUN_DIR/prsmash.log") 2>&1

CHILD_PIDS=()
CLEANED_RUN_RESOURCES=false
SCRIPT_PGID=$(ps -o pgid= -p "$$" | tr -d ' ')

child_descendants() {
  local parent=$1 child
  pgrep -P "$parent" 2>/dev/null | while IFS= read -r child; do
    child_descendants "$child"
    printf '%s\n' "$child"
  done
}

remove_child_pid() {
  local finished=$1 pid
  local remaining=()
  for pid in "${CHILD_PIDS[@]}"; do
    [[ "$pid" == "$finished" ]] || remaining+=("$pid")
  done
  CHILD_PIDS=("${remaining[@]}")
}

send_signal_to_process_tree() {
  local signal=$1 root=$2 pid pgid
  local pids=()
  mapfile -t pids < <({ child_descendants "$root"; printf '%s\n' "$root"; } | awk 'NF && !seen[$0]++')

  for pid in "${pids[@]}"; do
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    if [[ -n "$pgid" && "$pgid" != "$SCRIPT_PGID" ]]; then
      kill "-$signal" -- "-$pgid" 2>/dev/null || true
    fi
  done

  for pid in "${pids[@]}"; do
    kill "-$signal" "$pid" 2>/dev/null || true
  done
}

terminate_children() {
  local pid
  for pid in "${CHILD_PIDS[@]}"; do
    send_signal_to_process_tree TERM "$pid"
  done
}

kill_remaining_children() {
  local pid
  for pid in "${CHILD_PIDS[@]}"; do
    send_signal_to_process_tree KILL "$pid"
  done
}

children_still_running() {
  local pid child
  for pid in "${CHILD_PIDS[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    while IFS= read -r child; do
      if kill -0 "$child" 2>/dev/null; then
        return 0
      fi
    done < <(child_descendants "$pid")
  done
  return 1
}

cleanup_run_resources() {
  [[ "$CLEANED_RUN_RESOURCES" == true ]] && return 0

  if children_still_running; then
    echo -e "${YELLOW}Skipping prsmash cleanup while review children are still running.${RESET}" >&2
    return 0
  fi

  local worktree_root="$RUN_DIR/worktrees"
  local removed_worktrees=0 failed_worktrees=0 deleted_refs=0 failed_refs=0
  local worktree ref

  if [[ -d "$worktree_root" ]]; then
    while IFS= read -r -d '' worktree; do
      [[ -d "$worktree" ]] || continue
      if git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if git -C "$PRSMASH_SOURCE_REPO" worktree remove --force "$worktree" >/dev/null 2>&1; then
          removed_worktrees=$((removed_worktrees + 1))
        else
          echo -e "${YELLOW}Could not remove worktree ${worktree}${RESET}" >&2
          failed_worktrees=$((failed_worktrees + 1))
        fi
      elif rm -rf "$worktree"; then
        removed_worktrees=$((removed_worktrees + 1))
      else
        echo -e "${YELLOW}Could not remove directory ${worktree}${RESET}" >&2
        failed_worktrees=$((failed_worktrees + 1))
      fi
    done < <(find "$worktree_root" -mindepth 1 -maxdepth 1 -type d -print0)
    rmdir "$worktree_root" 2>/dev/null || true
  fi

  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    if git -C "$PRSMASH_SOURCE_REPO" update-ref -d "$ref" >/dev/null 2>&1; then
      deleted_refs=$((deleted_refs + 1))
    else
      echo -e "${YELLOW}Could not delete ref ${ref}${RESET}" >&2
      failed_refs=$((failed_refs + 1))
    fi
  done < <(git -C "$PRSMASH_SOURCE_REPO" for-each-ref --format='%(refname)' "refs/prsmash/${RUN_ID}" 2>/dev/null || true)

  git -C "$PRSMASH_SOURCE_REPO" worktree prune >/dev/null 2>&1 || true

  if [[ "$removed_worktrees" -gt 0 || "$deleted_refs" -gt 0 || "$failed_worktrees" -gt 0 || "$failed_refs" -gt 0 ]]; then
    echo -e "${DIM}Cleaned up ${removed_worktrees} worktrees and ${deleted_refs} refs.${RESET}"
    if [[ "$failed_worktrees" -gt 0 || "$failed_refs" -gt 0 ]]; then
      echo -e "${YELLOW}Cleanup left ${failed_worktrees} worktrees and ${failed_refs} refs behind.${RESET}" >&2
    fi
  fi

  if [[ "$failed_worktrees" -eq 0 && "$failed_refs" -eq 0 ]]; then
    CLEANED_RUN_RESOURCES=true
  fi
}

cleanup_on_signal() {
  echo ""
  echo -e "${YELLOW}Interrupted — cancelling running reviews...${RESET}"
  terminate_children
  sleep 2
  kill_remaining_children
  local pid
  for pid in "${CHILD_PIDS[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
  cleanup_run_resources
  exit 130
}

trap cleanup_on_signal INT TERM
trap cleanup_run_resources EXIT

echo -e "${BOLD}prsmash${RESET} — automated PR review queue"
echo -e "${DIM}Run logs: ${RUN_DIR}${RESET}"
echo -e "${DIM}Source repo: ${PRSMASH_SOURCE_REPO}${RESET}"
echo -e "${DIM}Model: ${MODEL}${RESET}"
echo -e "${DIM}Thinking: ${THINKING_LEVEL}${RESET}"
if [[ "$AUTO_APPROVE_ALL" == true ]]; then
  echo -e "${YELLOW}Approval policy: override enabled — every eligible PR will be approved${RESET}"
elif [[ -n "${TRUSTED_AUTHORS//[[:space:],;]/}" ]]; then
  echo -e "${DIM}Trusted authors: ${TRUSTED_AUTHORS}${RESET}"
  echo -e "${DIM}Human approval: untrusted authors with ${APPROVAL_LINE_LIMIT}+ changed lines${RESET}"
else
  echo -e "${YELLOW}Approval policy: no trusted-author list — every eligible PR will be approved${RESET}"
fi
echo -e "${DIM}Approval Slack DM target: ${SLACK_APPROVAL_TARGET}${RESET}"
echo ""

if ! git -C "$PRSMASH_SOURCE_REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "PRSMASH_SOURCE_REPO is not a git worktree: $PRSMASH_SOURCE_REPO" >&2
  exit 1
fi

log_field() {
  local log_file=$1
  local name=$2
  grep -m1 "^${name}=" "$log_file" 2>/dev/null | cut -d= -f2- || true
}

approval_line_summary() {
  local log_file=$1
  local changed additions deletions base_oid head_oid worktree shortstat files

  base_oid=$(log_field "$log_file" baseRefOid)
  head_oid=$(log_field "$log_file" headRefOid)
  worktree=$(log_field "$log_file" worktree)
  if [[ -n "$base_oid" && -n "$head_oid" && -n "$worktree" && -d "$worktree" ]]; then
    shortstat=$(git -C "$worktree" diff --shortstat "${base_oid}...${head_oid}" 2>/dev/null || true)
    additions=$(grep -oE '[0-9]+ insertions?\(\+\)' <<<"$shortstat" | awk '{print $1}' || true)
    deletions=$(grep -oE '[0-9]+ deletions?\(-\)' <<<"$shortstat" | awk '{print $1}' || true)
    files=$(grep -oE '[0-9]+ files? changed' <<<"$shortstat" | awk '{print $1}' || true)
    additions=${additions:-0}
    deletions=${deletions:-0}
    changed=$((additions + deletions))
    if [[ -n "$files" ]]; then
      printf '%s changed lines (+%s/-%s, %s files)' "$changed" "$additions" "$deletions" "$files"
    else
      printf '%s changed lines (+%s/-%s)' "$changed" "$additions" "$deletions"
    fi
    return 0
  fi

  printf 'changed line count unavailable'
}

slack_available() {
  local what=${1:-Slack}
  [[ "$SLACK_APPROVAL_NOTIFY" == "true" ]] || return 1
  [[ -x "$SLACK_SCRIPT" ]] || { echo -e "${DIM}Slack ${what} skipped: ${SLACK_SCRIPT} not executable${RESET}"; return 1; }
  [[ -n "${SLACK_MCP_XOXC_TOKEN:-}" && -n "${SLACK_MCP_XOXD_TOKEN:-}" ]] || { echo -e "${DIM}Slack ${what} skipped: Slack tokens not in environment${RESET}"; return 1; }
  return 0
}

# Our GitHub login. Approvals are checked before the queue fetch that sets
# $user, so fall back to asking gh directly and cache the answer.
GITHUB_LOGIN=""
github_login() {
  if [[ -z "$GITHUB_LOGIN" ]]; then
    if [[ -n "${user:-}" && "$user" != "null" ]]; then
      GITHUB_LOGIN="$user"
    else
      GITHUB_LOGIN=$(gh api user --jq .login 2>/dev/null) || return 1
    fi
  fi
  [[ -n "$GITHUB_LOGIN" ]] || return 1
  printf '%s' "$GITHUB_LOGIN"
}

approval_actor() {
  local profile
  if [[ -n "$APPROVAL_ACTOR" ]]; then
    printf '%s' "$APPROVAL_ACTOR"
    return 0
  fi
  profile=$("$SLACK_SCRIPT" profile 2>/dev/null) || return 1
  jq -r '.user_id // empty' <<<"$profile" 2>/dev/null
}

notify_approval_slack() {
  local kind=$1
  local pr_number=$2
  local pr_repo=$3
  local pr_title=$4
  local pr_author=$5
  local log_file=$6
  local head_oid marker_dir marker_file safe_key line_summary pr_url target channel message

  slack_available "notification" || return 0

  head_oid=$(log_field "$log_file" headRefOid)
  safe_key=$(printf '%s-%s-%s-%s' "$kind" "$pr_repo" "$pr_number" "${head_oid:-unknown-head}" | tr '/:' '__')
  marker_dir="$LOG_ROOT/approval-notifications"
  marker_file="$marker_dir/${safe_key}.sent"
  if [[ -f "$marker_file" ]]; then
    echo -e "${DIM}Slack notification already sent for #${pr_number} at ${head_oid:-unknown head}${RESET}"
    return 0
  fi

  mkdir -p "$marker_dir"
  pr_url="https://github.com/${pr_repo}/pull/${pr_number}"
  line_summary=$(approval_line_summary "$log_file")

  if [[ "$kind" == "awaiting-approval" ]]; then
    message=$(printf 'Needs your approval: PR #%s\n%s\n%s\nprsmash reviewed this and found nothing blocking.\nAuthor: %s\nLines: %s\nReact :%s: to approve it, :%s: to leave it.\nLog: %s' \
      "$pr_number" \
      "$pr_title" \
      "$pr_url" \
      "$pr_author" \
      "$line_summary" \
      "${APPROVE_REACTIONS%%,*}" \
      "${REJECT_REACTIONS%%,*}" \
      "$log_file")
  else
    message=$(printf 'PR approved by prsmash\n#%s — %s\n%s\nLines: %s\nAuthor: %s\nLog: %s' \
      "$pr_number" \
      "$pr_title" \
      "$pr_url" \
      "$line_summary" \
      "$pr_author" \
      "$log_file")
  fi

  if [[ -n "${PRSMASH_SLACK_APPROVAL_CHANNEL:-}" ]]; then
    channel="$PRSMASH_SLACK_APPROVAL_CHANNEL"
  else
    target="$SLACK_APPROVAL_TARGET"
    if ! channel=$("$SLACK_SCRIPT" resolve "$target" 2>/dev/null); then
      echo -e "${DIM}Slack notification skipped: could not resolve ${target}${RESET}"
      return 0
    fi
  fi

  local send_output message_ts
  if send_output=$(printf '%s\n' "$message" | "$SLACK_SCRIPT" send "$channel" - 2>/dev/null); then
    date -Is > "$marker_file"
    echo -e "${DIM}Slack ${kind} notification sent for #${pr_number}${RESET}"
    if [[ "$kind" == "awaiting-approval" ]]; then
      message_ts=$(jq -r '.ts // empty' <<<"$send_output" 2>/dev/null || true)
      if [[ -n "$message_ts" ]]; then
        record_pending_approval "$safe_key" "$pr_number" "$pr_repo" "$pr_title" "$pr_author" \
          "${head_oid:-}" "$channel" "$message_ts"
      else
        echo -e "${YELLOW}Could not read the Slack message ts for #${pr_number}; reaction approval is unavailable for it${RESET}" >&2
      fi
    fi
  else
    echo -e "${DIM}Slack ${kind} notification failed for #${pr_number}${RESET}"
  fi
}

record_pending_approval() {
  local key=$1 pr_number=$2 pr_repo=$3 pr_title=$4 pr_author=$5 head_oid=$6 channel=$7 message_ts=$8
  local tmp="$PENDING_DIR/.${key}.tmp"

  mkdir -p "$PENDING_DIR"
  if jq -n \
      --arg repo "$pr_repo" \
      --argjson pr "$pr_number" \
      --arg title "$pr_title" \
      --arg author "$pr_author" \
      --arg head "$head_oid" \
      --arg channel "$channel" \
      --arg ts "$message_ts" \
      --arg createdAt "$(date -Is)" \
      '{repo: $repo, pr: $pr, title: $title, author: $author, head: $head, channel: $channel, ts: $ts, createdAt: $createdAt}' \
      > "$tmp"; then
    mv "$tmp" "$PENDING_DIR/${key}.json"
    echo -e "${DIM}Awaiting a Slack reaction on #${pr_number} to approve${RESET}"
  else
    rm -f "$tmp"
    echo -e "${YELLOW}Could not record the pending approval for #${pr_number}${RESET}" >&2
  fi
}

in_reaction_set() {
  local name=$1 set=$2
  printf '%s\n' "${set//,/$'\n'}" | grep -Fxq -- "$name"
}

# approve | reject | none | error. A reject alongside an approve wins, so a
# mind changed by adding the opposite reaction fails safe.
reaction_decision() {
  local channel=$1 message_ts=$2 actor=$3
  local resp name approve=false reject=false

  resp=$("$SLACK_SCRIPT" reactions "$channel" "$message_ts" 2>/dev/null) || { echo error; return 0; }
  jq -e 'type == "array"' >/dev/null 2>&1 <<<"$resp" || { echo error; return 0; }

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if in_reaction_set "$name" "$APPROVE_REACTIONS"; then approve=true; fi
    if in_reaction_set "$name" "$REJECT_REACTIONS"; then reject=true; fi
  done < <(jq -r --arg actor "$actor" '.[] | select((.users // []) | index($actor)) | .name' <<<"$resp")

  if [[ "$reject" == true ]]; then
    echo reject
  elif [[ "$approve" == true ]]; then
    echo approve
  else
    echo none
  fi
}

reply_in_slack_thread() {
  local channel=$1 message_ts=$2 text=$3
  printf '%s\n' "$text" | "$SLACK_SCRIPT" send "$channel" - "$message_ts" >/dev/null 2>&1 || true
}

# Retire a pending approval. The record moves to processed/ with its outcome, so
# the same reaction is never acted on twice and there is a trail of what happened.
finish_pending_approval() {
  local file=$1 outcome=$2
  local base tmp
  base=$(basename "$file")
  tmp="$PROCESSED_DIR/.${base}.tmp"

  mkdir -p "$PROCESSED_DIR"
  if jq --arg outcome "$outcome" --arg at "$(date -Is)" \
      '. + {outcome: $outcome, processedAt: $at}' "$file" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$PROCESSED_DIR/$base"
    rm -f "$file"
  else
    rm -f "$tmp"
    # Never leave it pending after acting — a stale record would replay.
    mv "$file" "$PROCESSED_DIR/$base" 2>/dev/null || rm -f "$file"
  fi
}

apply_slack_approval() {
  local file=$1 pr_repo=$2 pr_number=$3 head_oid=$4 channel=$5 message_ts=$6
  local pr_json pr_state pr_merged current_head already me

  if ! me=$(github_login); then
    echo -e "${YELLOW}Could not determine our GitHub login; leaving #${pr_number} pending${RESET}" >&2
    return 0
  fi

  pr_json=$(gh api "repos/${pr_repo}/pulls/${pr_number}" 2>/dev/null) || {
    # Transient GitHub failure: leave it pending and retry on the next run.
    echo -e "${YELLOW}Could not read PR #${pr_number} to apply your approval; will retry${RESET}" >&2
    return 0
  }
  pr_state=$(jq -r '.state // ""' <<<"$pr_json")
  pr_merged=$(jq -r '.merged // false' <<<"$pr_json")
  current_head=$(jq -r '.head.sha // ""' <<<"$pr_json")

  if [[ "$pr_merged" == "true" || "$pr_state" != "open" ]]; then
    local disposition="closed"
    [[ "$pr_merged" == "true" ]] && disposition="merged"
    echo -e "  ${DIM}#${pr_number} was ${disposition} before you approved it — nothing to do${RESET}"
    finish_pending_approval "$file" "closed-before-approval"
    return 0
  fi

  if [[ -n "$head_oid" && "$current_head" != "$head_oid" ]]; then
    echo -e "  ${YELLOW}#${pr_number} moved on since that review — not approving${RESET}"
    reply_in_slack_thread "$channel" "$message_ts" \
      "Not approving: the PR has new commits since that review. prsmash will review the new head and ask again."
    finish_pending_approval "$file" "stale-head"
    return 0
  fi

  already=$(gh api --paginate --slurp "repos/${pr_repo}/pulls/${pr_number}/reviews" 2>/dev/null \
    | jq -r --arg me "$me" --arg sha "$current_head" \
        '[.[] | .[] | select(.user.login == $me and .state == "APPROVED" and .commit_id == $sha)] | length' 2>/dev/null || echo 0)
  if [[ "$already" =~ ^[0-9]+$ ]] && [[ "$already" -gt 0 ]]; then
    echo -e "  ${DIM}#${pr_number} is already approved at this commit${RESET}"
    finish_pending_approval "$file" "already-approved"
    return 0
  fi

  if gh api "repos/${pr_repo}/pulls/${pr_number}/reviews" \
      --method POST \
      -f event=APPROVE \
      -f commit_id="$current_head" \
      >/dev/null 2>&1; then
    echo -e "  ${GREEN}Approved #${pr_number}${RESET} ${DIM}on your Slack reaction${RESET}"
    finish_pending_approval "$file" "approved"
  else
    echo -e "  ${RED}Could not approve #${pr_number}; will retry${RESET}" >&2
  fi
}

handle_pending_approval() {
  local file=$1 actor=$2
  local pr_repo pr_number head_oid channel message_ts decision

  pr_repo=$(jq -r '.repo // ""' "$file" 2>/dev/null || true)
  pr_number=$(jq -r '.pr // ""' "$file" 2>/dev/null || true)
  head_oid=$(jq -r '.head // ""' "$file" 2>/dev/null || true)
  channel=$(jq -r '.channel // ""' "$file" 2>/dev/null || true)
  message_ts=$(jq -r '.ts // ""' "$file" 2>/dev/null || true)

  if [[ -z "$pr_repo" || -z "$pr_number" || -z "$channel" || -z "$message_ts" ]]; then
    echo -e "  ${YELLOW}Discarding unreadable pending approval $(basename "$file")${RESET}" >&2
    finish_pending_approval "$file" "unreadable"
    return 0
  fi

  decision=$(reaction_decision "$channel" "$message_ts" "$actor")

  if [[ "$DRY_RUN" == true ]]; then
    echo -e "  ${DIM}#${pr_number} (${pr_repo}) — reaction: ${decision}${RESET}"
    return 0
  fi

  case "$decision" in
    approve) apply_slack_approval "$file" "$pr_repo" "$pr_number" "$head_oid" "$channel" "$message_ts" ;;
    reject)
      echo -e "  ${DIM}#${pr_number} left unapproved on your reaction${RESET}"
      reply_in_slack_thread "$channel" "$message_ts" "Left unapproved. The review comment stays on the PR."
      finish_pending_approval "$file" "rejected" ;;
    error)
      echo -e "  ${YELLOW}Could not read reactions for #${pr_number}; will retry${RESET}" >&2 ;;
    *) : ;;
  esac
}

# Pending approvals are checked at the start of every run, so a reaction is
# picked up by the next tick without a second poller. A dedicated lock keeps
# overlapping runs from racing on the same record.
process_pending_approvals() {
  local file actor lock_fd expired
  local files=()

  shopt -s nullglob
  files=("$PENDING_DIR"/*.json)
  shopt -u nullglob
  [[ ${#files[@]} -gt 0 ]] || return 0

  if ! slack_available "pending approval check"; then
    echo -e "${DIM}${#files[@]} approval(s) still waiting on a Slack reaction${RESET}"
    return 0
  fi

  exec {lock_fd}>"$LOG_ROOT/locks/approvals.lock"
  if ! flock -n "$lock_fd"; then
    echo -e "${DIM}Another run is checking pending approvals; skipping${RESET}"
    exec {lock_fd}>&-
    return 0
  fi

  if ! actor=$(approval_actor) || [[ -z "$actor" ]]; then
    echo -e "${YELLOW}Could not determine whose Slack reactions to trust; skipping approval check${RESET}" >&2
    exec {lock_fd}>&-
    return 0
  fi

  # Drop anything that has sat unanswered past the TTL before spending API calls.
  if [[ "$APPROVAL_PENDING_TTL_DAYS" =~ ^[0-9]+$ ]] && [[ "$APPROVAL_PENDING_TTL_DAYS" -gt 0 ]] && [[ "$DRY_RUN" != true ]]; then
    while IFS= read -r expired; do
      [[ -n "$expired" ]] || continue
      echo -e "  ${DIM}Dropping approval for $(basename "$expired" .json) after ${APPROVAL_PENDING_TTL_DAYS} days${RESET}"
      finish_pending_approval "$expired" "expired"
    done < <(find "$PENDING_DIR" -maxdepth 1 -name '*.json' -mtime "+${APPROVAL_PENDING_TTL_DAYS}" 2>/dev/null)

    shopt -s nullglob
    files=("$PENDING_DIR"/*.json)
    shopt -u nullglob
  fi

  if [[ ${#files[@]} -gt 0 ]]; then
    echo -e "${DIM}Checking ${#files[@]} pending approval(s) for Slack reactions...${RESET}"
    for file in "${files[@]}"; do
      [[ -f "$file" ]] || continue
      handle_pending_approval "$file" "$actor"
    done
    echo ""
  fi

  exec {lock_fd}>&-
}

# --- Pending approvals ---
# Ahead of the queue fetch, because every path out of the queue section can exit
# early — an empty queue is the common case, and a reaction left since the last
# run still has to be applied.
process_pending_approvals

# --- Fetch queue ---
echo -e "${DIM}Fetching review queue...${RESET}"
queue_args=()
if [[ "$INCLUDE_IMPLICIT" == true ]] && [[ "$SKIP_SELECT" == false ]]; then
  queue_args+=(--include-implicit)
fi
queue_json=$($QUEUE_SCRIPT "${queue_args[@]}")
printf '%s\n' "$queue_json" > "$RUN_DIR/queue.json"

# Some queue-script versions return a human-readable message before the current
# user has any review history in a repository. Treat that as an empty queue,
# while still failing closed for any other malformed response.
if ! jq -e 'type == "object" and (.prs | type == "array")' >/dev/null 2>&1 <<<"$queue_json"; then
  if [[ "$queue_json" == No\ PRs* ]]; then
    printf '%s\n' "$queue_json"
    exit 0
  fi
  echo "Queue script returned an invalid response; see $RUN_DIR/queue.json" >&2
  exit 1
fi

repo=$(echo "$queue_json" | jq -r '.repo')
user=$(echo "$queue_json" | jq -r '.user')

if [[ -n "$repo" && "$repo" != "null" ]]; then
  source_repo_name=$(gh repo view "$repo" --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  if [[ "$source_repo_name" != "$repo" ]]; then
    echo "Could not validate GitHub repo from queue: $repo" >&2
    exit 1
  fi
fi

if [[ "$SKIP_SELECT" == true ]]; then
  queue_json=$(echo "$queue_json" | jq '.prs |= map(select(.implicitRereview != true))')
fi

# Manual and dry-run views can hide exact heads already handled outside GitHub
# review state. Scheduled runs defer this check until after refreshing the head
# under the per-PR lock, so a push between queue fetch and launch cannot be lost.
if [[ "$SKIP_SELECT" != true || "$DRY_RUN" == true ]]; then
  queue_json=$(filter_review_dispositions "$queue_json")
fi
printf '%s\n' "$queue_json" > "$RUN_DIR/queue-filtered.json"

pr_count=$(echo "$queue_json" | jq '.prs | length')
implicit_count=$(echo "$queue_json" | jq '[.prs[] | select(.implicitRereview == true)] | length')

if [[ "$pr_count" -eq 0 ]]; then
  echo "No PRs waiting for review."
  exit 0
fi

echo -e "Found ${BOLD}${pr_count}${RESET} PRs in ${repo}"
echo ""

# --- Dry run ---
if [[ "$DRY_RUN" == true ]]; then
  echo -e "${YELLOW}Dry run — listing PRs without reviewing${RESET}"
  echo ""
  for i in $(seq 0 $((pr_count - 1))); do
    pr_number=$(echo "$queue_json" | jq -r ".prs[$i].number")
    pr_title=$(echo "$queue_json" | jq -r ".prs[$i].title")
    pr_author=$(echo "$queue_json" | jq -r ".prs[$i].author.login")
    needs_rereview=$(echo "$queue_json" | jq -r ".prs[$i].needsRereview")
    implicit_rereview=$(echo "$queue_json" | jq -r ".prs[$i].implicitRereview")
    tag=""
    [[ "$needs_rereview" == "true" ]] && tag=" ${YELLOW}[re-review]${RESET}"
    [[ "$implicit_rereview" == "true" ]] && tag=" ${BLUE}[implicit re-review]${RESET}"
    echo -e "  #${pr_number} — ${pr_title} ${DIM}(${pr_author})${RESET}${tag}"
  done
  exit 0
fi

# --- Selection ---
if [[ "$SKIP_SELECT" == false ]] && [[ "$pr_count" -gt 1 ]]; then
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required for interactive selection. Install fzf or use --all." >&2
    exit 1
  fi

  fzf_input=$(
    for i in $(seq 0 $((pr_count - 1))); do
      pr_number=$(echo "$queue_json" | jq -r ".prs[$i].number")
      pr_title=$(echo "$queue_json" | jq -r ".prs[$i].title")
      pr_author=$(echo "$queue_json" | jq -r ".prs[$i].author.login")
      needs_rereview=$(echo "$queue_json" | jq -r ".prs[$i].needsRereview")
      implicit_rereview=$(echo "$queue_json" | jq -r ".prs[$i].implicitRereview")
      tag=""
      [[ "$needs_rereview" == "true" ]] && tag=" [re-review]"
      [[ "$implicit_rereview" == "true" ]] && tag=" [implicit re-review]"
      printf '%s\t#%s — %s (%s)%s\n' "$pr_number" "$pr_number" "$pr_title" "$pr_author" "$tag"
    done
  )

  fzf_header=$'TAB: toggle  Ctrl-A: toggle-all  ENTER: review selected  ESC: cancel\n[implicit re-review] PRs are not included in --all and must be selected manually.'
  fzf_binds=(--bind 'ctrl-a:toggle-all')
  if [[ "$implicit_count" -eq 0 ]]; then
    fzf_header=$'TAB: toggle  Ctrl-A: toggle-all  ENTER: review selected  ESC: cancel\nAll PRs pre-selected — press ENTER to review everything.'
    fzf_binds=(--bind 'start:select-all' --bind 'ctrl-a:toggle-all')
  fi

  selected=$(printf '%s\n' "$fzf_input" | fzf \
    --multi \
    --delimiter=$'\t' \
    --with-nth=2 \
    --header="$fzf_header" \
    "${fzf_binds[@]}" \
    --height=80% \
    --reverse \
    --prompt='PRs> ' || true)

  if [[ -z "$selected" ]]; then
    echo "No PRs selected. Exiting."
    exit 0
  fi

  selected_numbers=$(echo "$selected" | cut -f1)
  sel_array_json=$(echo "$selected_numbers" | jq -R -s -c 'split("\n") | map(select(length > 0) | tonumber)')
  queue_json=$(echo "$queue_json" | jq --argjson sel "$sel_array_json" \
    '.prs |= map(select(.number as $n | $sel | index($n) != null))')
  pr_count=$(echo "$queue_json" | jq '.prs | length')

  echo -e "Reviewing ${BOLD}${pr_count}${RESET} selected PRs"
  echo ""
fi

# --- Parallel review ---
MAX_RETRIES=2
RETRY_DELAY=30

reviewed=0
approved=0
manual_approval=0
changes_requested=0
errored=0
# A PR already being reviewed by an overlapping run is a routine outcome now
# that scheduled runs overlap, not a failure. Counting it separately keeps
# errored meaning "something actually went wrong".
skipped=0

is_retryable() {
  local log_file=$1
  grep -qE 'API Error: 5[0-9]{2}|overloaded_error|api_error|rate_limit|temporarily unavailable|service unavailable' "$log_file" 2>/dev/null
}

prepare_pr_context() {
  local pr_number=$1
  local pr_repo=$2
  local worktree_dir=$3
  local tmp_dir=$4

  mkdir -p "$RUN_DIR/worktrees" "$RUN_DIR/tmp" "$tmp_dir"

  local meta base_ref base_oid head_ref head_oid actual_head git_files gh_files
  meta=$(gh pr view "$pr_number" --repo "$pr_repo" --json number,baseRefName,baseRefOid,headRefName,headRefOid)
  base_ref=$(jq -r '.baseRefName' <<<"$meta")
  base_oid=$(jq -r '.baseRefOid' <<<"$meta")
  head_ref=$(jq -r '.headRefName' <<<"$meta")
  head_oid=$(jq -r '.headRefOid' <<<"$meta")
  if [[ -z "$base_ref" || -z "$base_oid" || -z "$head_ref" || -z "$head_oid" || "$base_ref" == "null" || "$base_oid" == "null" || "$head_ref" == "null" || "$head_oid" == "null" ]]; then
    echo "Context verification failed for PR #${pr_number}: incomplete PR metadata" >&2
    printf '%s\n' "$meta" >&2
    return 1
  fi

  git -C "$PRSMASH_SOURCE_REPO" fetch origin "$base_ref" >/dev/null
  git -C "$PRSMASH_SOURCE_REPO" fetch origin "+pull/${pr_number}/head:refs/prsmash/${RUN_ID}/pr-${pr_number}" >/dev/null

  if [[ -d "$worktree_dir/.git" ]] || git -C "$worktree_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    actual_head=$(git -C "$worktree_dir" rev-parse HEAD)
    if [[ "$actual_head" != "$head_oid" ]]; then
      git -C "$PRSMASH_SOURCE_REPO" worktree remove --force "$worktree_dir" >/dev/null 2>&1 || rm -rf "$worktree_dir"
      git -C "$PRSMASH_SOURCE_REPO" worktree add --detach "$worktree_dir" "$head_oid" >/dev/null
    fi
  else
    rm -rf "$worktree_dir"
    git -C "$PRSMASH_SOURCE_REPO" worktree add --detach "$worktree_dir" "$head_oid" >/dev/null
  fi

  actual_head=$(git -C "$worktree_dir" rev-parse HEAD)
  if [[ "$actual_head" != "$head_oid" ]]; then
    echo "Context verification failed for PR #${pr_number}: worktree HEAD $actual_head != GitHub head $head_oid" >&2
    return 1
  fi

  if [[ -n "$(git -C "$worktree_dir" status --porcelain)" ]]; then
    echo "Context verification failed for PR #${pr_number}: isolated worktree is dirty" >&2
    git -C "$worktree_dir" status --short >&2 || true
    return 1
  fi

  git_files=$(git -C "$worktree_dir" diff --name-only "${base_oid}...${head_oid}" | sort)
  gh_files=$(gh pr diff "$pr_number" --repo "$pr_repo" --name-only | sort)
  if ! diff -u <(printf '%s
' "$git_files") <(printf '%s
' "$gh_files") >/dev/null; then
    echo "Context verification failed for PR #${pr_number}: git changed files differ from GitHub changed files" >&2
    diff -u <(printf '%s
' "$git_files") <(printf '%s
' "$gh_files") >&2 || true
    return 1
  fi

  cat <<EOF
PRSMASH_CONTEXT
repo=$pr_repo
pr=$pr_number
sourceRepo=$PRSMASH_SOURCE_REPO
baseRefName=$base_ref
baseRefOid=$base_oid
headRefName=$head_ref
headRefOid=$head_oid
worktree=$worktree_dir
actualHead=$actual_head
tmpdir=$tmp_dir
changedFilesGit<<PRSMASH_FILES
$git_files
PRSMASH_FILES
changedFilesGh<<PRSMASH_FILES
$gh_files
PRSMASH_FILES
END_PRSMASH_CONTEXT
EOF
}

run_pr_review() {
  local pr_number=$1
  local pr_repo=$2
  local since_commit=$3
  local session_dir="$RUN_DIR/sessions/pr-${pr_number}"
  local worktree_dir="$RUN_DIR/worktrees/pr-${pr_number}"
  local tmp_dir="$RUN_DIR/tmp/pr-${pr_number}"
  local result_file="$tmp_dir/review-result.json"
  mkdir -p "$session_dir" "$tmp_dir"
  rm -f "$result_file"

  prepare_pr_context "$pr_number" "$pr_repo" "$worktree_dir" "$tmp_dir"
  local analyzed_head
  analyzed_head=$(git -C "$worktree_dir" rev-parse HEAD)

  # Incremental re-review: when we know the commit our last review looked at,
  # narrow the review to what changed since. Only valid if that commit is an
  # ancestor of the current head (a rebase/force-push invalidates it).
  local skill_cmd="/skill:pr-review --headless --pr ${pr_number}"
  if [[ -n "$since_commit" && "$since_commit" != "null" ]]; then
    if git -C "$worktree_dir" cat-file -e "$since_commit" 2>/dev/null \
       && git -C "$worktree_dir" merge-base --is-ancestor "$since_commit" HEAD 2>/dev/null \
       && [[ "$since_commit" != "$(git -C "$worktree_dir" rev-parse HEAD)" ]]; then
      skill_cmd="/skill:pr-review --headless --pr ${pr_number} --since ${since_commit}"
      echo "incrementalReviewSince=${since_commit}"
    else
      echo "incrementalReviewSince=invalid (${since_commit} not an ancestor of head; running full review)"
    fi
  fi

  local args=(--session-dir "$session_dir" --skill "$PR_REVIEW_SKILL_DIR" -p "$skill_cmd")
  if [[ -n "$THINKING_LEVEL" ]]; then
    args=(--thinking "$THINKING_LEVEL" "${args[@]}")
  fi
  if [[ -n "$MODEL" ]]; then
    args=(--model "$MODEL" "${args[@]}")
  fi
  # Keep the timeout inside setsid: `setsid pi` may fork rather than exec, which
  # would let an outer timeout return before pi has finished.
  local runner=(timeout --kill-after=60 "$REVIEW_TIMEOUT" pi "${args[@]}")
  if command -v setsid >/dev/null 2>&1; then
    runner=(setsid "${runner[@]}")
  fi

  local rc=0
  (cd "$worktree_dir" && TMPDIR="$tmp_dir" PR_REVIEW_TMPDIR="$tmp_dir" PRSMASH_REVIEW_RESULT_FILE="$result_file" PRSMASH_REVIEW_EXPECTED_HEAD="$analyzed_head" PRSMASH_APPROVAL_LINE_LIMIT="$APPROVAL_LINE_LIMIT" PRSMASH_TRUSTED_AUTHORS="$TRUSTED_AUTHORS" PRSMASH_AUTO_APPROVE_ALL="$AUTO_APPROVE_ALL" "${runner[@]}") || rc=$?
  if [[ $rc -eq 124 || $rc -eq 137 ]]; then
    echo "PRSMASH_REVIEW_TIMEOUT: killed after ${REVIEW_TIMEOUT}s"
  fi
  return $rc
}

append_latest_review_body() {
  local pr_number=$1
  local pr_repo=$2
  local log_file=$3

  {
    echo ""
    echo "========== Posted GitHub review =========="
    gh api --paginate --slurp "repos/${pr_repo}/pulls/${pr_number}/reviews" 2>/dev/null \
      | jq -r --arg me "$user" '
          [.[] | .[] | select(.user.login == $me)] | last as $review
          | if $review == null then
              "No GitHub review found for " + $me
            else
              "state: \($review.state)\nid: \($review.id)\nsubmitted_at: \($review.submitted_at)\n\n\($review.body // "")"
            end
        ' \
      || echo "Failed to fetch posted GitHub review body."
    echo "========== End posted GitHub review =========="
  } >> "$log_file"
}

review_pr_bg() {
  local pr_number=$1
  local pr_repo=$2
  local log_file=$3
  local status_file=$4
  local since_commit=$5
  local head_oid=$6
  local start end duration attempt=1 latest_state lock_name disposition_source
  local result_file result_head result_posting result_manual analyzed_head

  lock_name=$(printf '%s-%s' "$pr_repo" "$pr_number" | tr '/:' '__')
  exec {pr_lock_fd}>"$LOG_ROOT/locks/pr-${lock_name}.lock"
  if ! flock -n "$pr_lock_fd"; then
    printf 'LOCKED||0\n' > "$status_file"
    return 0
  fi

  # The queue may have been fetched while an overlapping run was finishing or
  # while the author pushed. Refresh GitHub under the per-PR lock, then check the
  # exact current head against the disposition written by the previous holder.
  if ! head_oid=$(gh api "repos/${pr_repo}/pulls/${pr_number}" --jq '.head.sha' 2>/dev/null) \
      || [[ ! "$head_oid" =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    echo "Could not refresh the current head for ${pr_repo}#${pr_number}; refusing to launch a review." > "$log_file"
    printf 'ERR||0\n' > "$status_file"
    return 1
  fi
  if review_disposition_exists "$pr_repo" "$pr_number" "$head_oid"; then
    printf 'HANDLED||0\n' > "$status_file"
    return 0
  fi

  start=$(date +%s)
  while [[ $attempt -le $MAX_RETRIES ]]; do
    if run_pr_review "$pr_number" "$pr_repo" "$since_commit" > "$log_file" 2>&1; then
      end=$(date +%s)
      duration=$((end - start))
      # GitHub's effective review state ignores COMMENTED reviews — only
      # APPROVED/CHANGES_REQUESTED change state. Prefer the latest of those.
      # Paginate: a single page (30) can miss recent reviews on busy PRs.
      latest_state=$(gh api --paginate --slurp "repos/${pr_repo}/pulls/${pr_number}/reviews" 2>/dev/null \
        | jq -r --arg me "$user" '
            [.[] | .[]] as $all
            | ([$all[] | select(.user.login == $me) | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")] | last | .state)
            // ([$all[] | select(.user.login == $me)] | last | .state)
            // "UNKNOWN"
          ' 2>/dev/null || echo "UNKNOWN")
      append_latest_review_body "$pr_number" "$pr_repo" "$log_file"
      disposition_source=""
      result_file="$RUN_DIR/tmp/pr-${pr_number}/review-result.json"
      analyzed_head=$(git -C "$RUN_DIR/worktrees/pr-${pr_number}" rev-parse HEAD 2>/dev/null || true)
      if jq -e --arg repo "$pr_repo" --argjson pr "$pr_number" --arg head "$analyzed_head" \
          '.repo == $repo and .pr == $pr and .head == $head' "$result_file" >/dev/null 2>&1; then
        result_head=$(jq -r '.head // empty' "$result_file")
        result_posting=$(jq -r '.posting // empty' "$result_file")
        result_manual=$(jq -r '.manualApprovalRequired // false' "$result_file")
        if [[ "$result_manual" == "true" ]]; then
          latest_state="MANUAL_APPROVAL_REQUIRED"
          disposition_source="manual-approval-required"
        elif [[ "$result_posting" == "issue-comment" ]]; then
          disposition_source="issue-comment-review"
        fi
        if [[ -n "$disposition_source" ]] \
            && ! record_review_disposition "$pr_repo" "$pr_number" "$result_head" "$disposition_source"; then
          echo "Could not persist the review disposition for ${pr_repo}#${pr_number} at ${result_head}; this head may be reviewed again." >&2
        fi
      fi
      printf 'OK|%s|%d\n' "$latest_state" "$duration" > "$status_file"
      return 0
    fi
    if [[ $attempt -lt $MAX_RETRIES ]] && is_retryable "$log_file"; then
      sleep "$RETRY_DELAY"
      attempt=$((attempt + 1))
      continue
    fi
    break
  done
  end=$(date +%s)
  duration=$((end - start))
  printf 'ERR||%d\n' "$duration" > "$status_file"
  return 1
}

declare -A pid_info

echo -e "${DIM}Launching ${pr_count} reviews in parallel...${RESET}"
echo ""

for i in $(seq 0 $((pr_count - 1))); do
  pr_number=$(echo "$queue_json" | jq -r ".prs[$i].number")
  pr_title=$(echo "$queue_json" | jq -r ".prs[$i].title")
  pr_author=$(echo "$queue_json" | jq -r ".prs[$i].author.login")
  needs_rereview=$(echo "$queue_json" | jq -r ".prs[$i].needsRereview")
  implicit_rereview=$(echo "$queue_json" | jq -r ".prs[$i].implicitRereview")
  queue_source=$(echo "$queue_json" | jq -r ".prs[$i].queueSource // \"review-request\"")
  my_review_commit=$(echo "$queue_json" | jq -r ".prs[$i].myReviewCommit // empty")
  head_oid=$(echo "$queue_json" | jq -r ".prs[$i].headRefOid // empty")
  pr_repo=$(echo "$queue_json" | jq -r ".prs[$i].repository.nameWithOwner")

  since_commit=""
  [[ "$needs_rereview" == "true" ]] && since_commit="$my_review_commit"

  safe_repo=$(echo "$pr_repo" | tr '/:' '__')
  log_file="$RUN_DIR/pr-${pr_number}-${safe_repo}.log"
  status_file="$RUN_DIR/pr-${pr_number}.status"
  rm -f "$status_file"

  review_pr_bg "$pr_number" "$pr_repo" "$log_file" "$status_file" "$since_commit" "$head_oid" &
  pid=$!
  CHILD_PIDS+=("$pid")
  pid_info[$pid]="${pr_number}"$'\t'"${pr_title}"$'\t'"${pr_author}"$'\t'"${needs_rereview}"$'\t'"${log_file}"$'\t'"${status_file}"$'\t'"${pr_repo}"

  tag=""
  [[ "$needs_rereview" == "true" ]] && tag=" ${YELLOW}[re-review]${RESET}"
  [[ "$queue_source" == "threads-resolved" ]] && tag=" ${YELLOW}[re-review: threads resolved]${RESET}"
  [[ "$implicit_rereview" == "true" ]] && tag=" ${BLUE}[implicit re-review]${RESET}"
  echo -e "  ${DIM}started${RESET} #${pr_number} — ${pr_title} ${DIM}(${pr_author})${RESET}${tag}"
done

echo ""
echo -e "${DIM}Waiting for reviews to complete...${RESET}"
echo ""

completed=0
total=$pr_count
while [[ $completed -lt $total ]]; do
  wait -n -p finished_pid || true
  if [[ -z "${finished_pid:-}" ]] || [[ -z "${pid_info[$finished_pid]:-}" ]]; then
    continue
  fi

  IFS=$'\t' read -r pr_number pr_title pr_author needs_rereview log_file status_file pr_repo <<< "${pid_info[$finished_pid]}"
  unset 'pid_info[$finished_pid]'
  remove_child_pid "$finished_pid"
  completed=$((completed + 1))

  if [[ -f "$status_file" ]]; then
    IFS='|' read -r result latest_state duration < "$status_file"
  else
    result=ERR
    latest_state=""
    duration=0
  fi

  mins=$((duration / 60))
  secs=$((duration % 60))
  time_str="${mins}m${secs}s"

  prefix="${BOLD}[${completed}/${total}]${RESET} #${pr_number}"
  suffix="${DIM}${pr_title} (${pr_author}) — ${time_str}${RESET}"

  case "${result}:${latest_state}" in
    OK:APPROVED)
      echo -e "${prefix} ${GREEN}Approved${RESET} ${suffix}"
      notify_approval_slack approved "$pr_number" "$pr_repo" "$pr_title" "$pr_author" "$log_file" || true
      approved=$((approved + 1))
      reviewed=$((reviewed + 1)) ;;
    OK:MANUAL_APPROVAL_REQUIRED)
      echo -e "${prefix} ${YELLOW}Review posted, awaiting your approval${RESET} ${suffix}"
      notify_approval_slack awaiting-approval "$pr_number" "$pr_repo" "$pr_title" "$pr_author" "$log_file" || true
      manual_approval=$((manual_approval + 1))
      reviewed=$((reviewed + 1)) ;;
    OK:CHANGES_REQUESTED)
      echo -e "${prefix} ${RED}Changes requested${RESET} ${suffix}"
      changes_requested=$((changes_requested + 1))
      reviewed=$((reviewed + 1)) ;;
    OK:*)
      echo -e "${prefix} ${BLUE}Commented${RESET} ${suffix}"
      reviewed=$((reviewed + 1)) ;;
    LOCKED:*)
      echo -e "${prefix} ${YELLOW}Skipped${RESET} ${suffix} ${DIM}— already being reviewed${RESET}"
      skipped=$((skipped + 1)) ;;
    HANDLED:*)
      echo -e "${prefix} ${YELLOW}Skipped${RESET} ${suffix} ${DIM}— this exact head already passed automated review${RESET}"
      skipped=$((skipped + 1)) ;;
    *)
      echo -e "${prefix} ${RED}Error${RESET} ${suffix} ${DIM}— see ${log_file}${RESET}"
      errored=$((errored + 1)) ;;
  esac
done

# --- Summary ---
cat > "$RUN_DIR/summary.txt" <<EOF
reviewed=$reviewed
errored=$errored
skipped=$skipped
approved=$approved
awaiting_manual_approval=$manual_approval
changes_requested=$changes_requested
EOF

cleanup_run_resources

echo ""
echo -e "${BOLD}Done${RESET} — ${reviewed} reviewed, ${errored} errored"
echo -e "  ${GREEN}${approved} approved${RESET}  ${RED}${changes_requested} changes requested${RESET}"
if [[ "$skipped" -gt 0 ]]; then
  echo -e "  ${YELLOW}${skipped} skipped${RESET} ${DIM}— already reviewed or in progress${RESET}"
fi
if [[ "$manual_approval" -gt 0 ]]; then
  echo -e "  ${YELLOW}${manual_approval} awaiting your approval${RESET} ${DIM}— review posted, approval left to you${RESET}"
fi
echo -e "  ${DIM}logs: ${RUN_DIR}${RESET}"
